{
  "name": "@RAG-codebase/api",
  "version": "1.0.0",
  "description": "",
  "main": "main.ts",
  "scripts": {
    "dev:setup:db" : "BUILD=dev tsx scripts/create-db.ts",
    "dev:db:generate" : "BUILD=dev drizzle-kit generate",
    "dev:db:migrate" : "BUILD=dev drizzle-kit migrate",
    "dev:db:push": "BUILD=dev drizzle-kit push",
    "dev:db:seed" : "BUILD=dev tsx ./src/db/seed.ts",
    "dev": "BUILD=dev tsx watch src/main.ts",

    "setup:db": "BUILD=release tsx scripts/create-db.ts",
    "setup:models": "tsx scripts/fetch-models.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    
    "build": "BUILD=release tsc",
    "start": "BUILD=release node dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "cors": "^2.8.6",
    "drizzle-orm": "1.0.0-rc.4",
    "express": "^5.2.1",
    "node-llama-cpp": "^3.20.0",
    "pg": "^8.23.0",
    "tree-sitter": "^0.25.1",
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.4",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3"
  }
}
